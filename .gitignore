/.claude/
/.publish/
/.local/

# Keep the archived site source visible in Git and keep local migration work private.
/site-v1/*
!/site-v1/README.md
!/site-v1/index.html
!/site-v1/old_site/
!/site-v1/folder/
!/site-v1/images/

# Keep font data local. Site lettering uses fixed PNG artwork.
*.otf
*.ttf
*.otc
*.ttc
*.woff
*.woff2
*.eot
*.dfont

# Local snapshots, source photos, and conversation exports.
/old_site/
/folder/
/mock-v1/
/site-v2/catalog-research/
/site-v2/content.before-bundles.js
/site-v2/photo-privacy-audit.json
**/originals/
**/raw-photos/
**/prompts/
**/conversation-logs/
**/chat-logs/
conversations.json
chat.html
prompts.json
*.original.*
*.log
*.jsonl
*.bak

